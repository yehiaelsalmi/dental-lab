// Prisma schema for the dental lab case management system
//
// SQLite has no native enum type, so CaseStatus/CaseFileType/ReviewDecision are
// plain strings constrained at the application layer (src/lib/constants.ts).
// Role permissions are JSON string arrays checked in src/lib/access.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  active       Boolean  @default(true)
  // Set when a user with history is deleted: they can't sign in and are hidden
  // from the Users page, but their name stays on past cases.
  deletedAt    DateTime?
  // Fixed monthly salary (EGP); counted in the monthly report and shown on
  // their own earnings page.
  baseSalary   Float?
  createdAt    DateTime @default(now())

  casesCreated  Case[]         @relation("CreatedBy")
  casesAssigned Case[]         @relation("AssignedDesigner")
  casesFirstDesigned Case[]    @relation("FirstDesigner")
  casesAsCeramist    Case[]    @relation("CaseCeramist")
  caseAssignments    CaseAssignment[]
  photogrammetryDone Case[]    @relation("PhotogrammetryDoneBy")
  filesUploaded CaseFile[]
  reviews       CaseReview[]
  notifications Notification[]
  invoices      Invoice[]
}

model Doctor {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  cases    Case[]
  invoices Invoice[]
}

// Managed by the Lab Leader on the Roles page. `key` marks the built-in roles;
// the LAB_LEADER role always has every permission and can't be edited.
model Role {
  id              String   @id @default(cuid())
  key             String?  @unique
  name            String   @unique
  // JSON string arrays: permission keys, visible statuses (empty = all) and
  // the events that notify this role (statuses or PHOTOGRAMMETRY_NEEDED).
  permissions     String   @default("[]")
  caseScope       String   @default("ALL")
  visibleStatuses String   @default("[]")
  notifyOn        String   @default("[]")
  // People with an assignable role (e.g. Milling, Printing) can be put on any
  // case at any time from the case page; feePerUnit is what they earn per unit.
  assignable      Boolean  @default(false)
  feePerUnit      Float?
  createdAt       DateTime @default(now())

  users       User[]
  assignments CaseAssignment[]
}

model IbarDesigner {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  cases Case[]
}

// Fixed rate card, managed by the Lab Leader. Rates are per unit and get
// locked onto the case at the moment each fee is actually incurred, so
// later rate changes never retroactively change past cases.
model Material {
  id                  String   @id @default(cuid())
  name                String   @unique
  pricePerUnit        Float
  ceramistFeePerUnit  Float
  designerFeePerUnit  Float
  ibarFeePerUnit      Float?
  // Flat amounts per case, added to / taken off the price billed to the doctor.
  extraFee            Float?
  deduction           Float?
  // Optional costs to the lab per unit; taken off profit, not billed.
  millingCostPerUnit        Float?
  photogrammetryCostPerUnit Float?
  createdAt           DateTime @default(now())

  caseLines CaseMaterial[]
}

model MetalType {
  id        String   @id @default(cuid())
  name      String   @unique
  cost      Float
  createdAt DateTime @default(now())

  caseLines CaseMaterial[]
}

model Case {
  id             String    @id @default(cuid())
  patientName    String
  // Totals of the material lines per arch (kept for lists, reports, invoices).
  unitsUpper     Int?
  unitsLower     Int?
  system         String?
  shade          String?
  status         String    @default("READY_FOR_DESIGN")
  entryDate      DateTime  @default(now())
  dueDate        DateTime?
  notes          String?
  // Name of whoever does matching; when set, the designer's submission goes
  // to MATCHING before review.
  matchingBy           String?
  needsPhotogrammetry  Boolean   @default(false)
  photogrammetryDoneAt DateTime?
  // Whoever marked photogrammetry done; they're credited the photogrammetry cost.
  photogrammetryDoneById String?
  photogrammetryDoneBy   User?   @relation("PhotogrammetryDoneBy", fields: [photogrammetryDoneById], references: [id])
  driveFolderId  String?
  driveFolderUrl String?

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  // The ceramist is a user whose role can be assigned as ceramist.
  ceramistId String?
  ceramist   User?   @relation("CaseCeramist", fields: [ceramistId], references: [id])

  ibarDesignerId String?
  ibarDesigner   IbarDesigner? @relation(fields: [ibarDesignerId], references: [id])
  // Ibar cases: the first designer works before the ibar (and the Lab Leader
  // reviews that design); `assignedDesigner` takes over once `ibarDoneAt` is set.
  firstDesignerId String?
  firstDesigner   User?     @relation("FirstDesigner", fields: [firstDesignerId], references: [id])
  ibarDoneAt      DateTime?


  // Locked-in amounts, filled in as each fee is actually incurred (see the
  // comment on Material above).
  totalPrice Float?
  extraFee    Float?
  deduction   Float?
  ceramistFee Float?
  designerFee Float?
  firstDesignerFee Float?
  ibarFee     Float?
  metalCost   Float?
  millingCost        Float?
  photogrammetryCost Float?

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  assignedDesignerId String?
  assignedDesigner   User?   @relation("AssignedDesigner", fields: [assignedDesignerId], references: [id])

  files         CaseFile[]
  reviews       CaseReview[]
  notifications Notification[]
  units         CaseUnit[]
  // What the case is made of: one line per arch + material (+ optional metal).
  materials     CaseMaterial[]
  // People from assignable roles (milling, printing, ...), one per role.
  assignments   CaseAssignment[]
  invoiceLines  InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CaseUnit {
  id        String   @id @default(cuid())
  code      String
  createdAt DateTime @default(now())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CaseFile {
  id          String @id @default(cuid())
  caseId      String
  case        Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type        String
  fileName    String
  driveFileId String
  driveLink   String

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
}

// Runtime settings edited from the admin UI (e.g. Google Drive connection),
// as opposed to deploy-time secrets which stay in .env.
model AppSetting {
  key   String @id
  value String
}

model CaseReview {
  id       String  @id @default(cuid())
  caseId   String
  case     Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  decision String
  comment  String?

  reviewedById String
  reviewedBy   User   @relation(fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// One per doctor per calendar month. Snapshots line amounts at generation
// time, so later edits to a case never change an already-generated invoice.
model Invoice {
  id          String   @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  totalAmount Float
  createdAt   DateTime @default(now())

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  generatedById String
  generatedBy   User   @relation(fields: [generatedById], references: [id])

  lines InvoiceLine[]

  @@unique([doctorId, periodStart])
}

model InvoiceLine {
  id          String @id @default(cuid())
  patientName String
  units       Int
  amount      Float

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
}

// One material line on a case, e.g. "Upper: Zirconia, 10 units, Titanium".
// A case can have several lines per arch; prices and fees are summed over them.
model CaseMaterial {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  arch      String // "UPPER" | "LOWER"
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  units      Int
  metalTypeId String?
  metalType   MetalType? @relation(fields: [metalTypeId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

// Statuses the Lab Leader adds on top of the built-in workflow (e.g.
// "Waiting for doctor"). Cases get into and out of them with "Move to status".
// `afterStatus` is where it's listed: right after that built-in or custom status.
model CustomStatus {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String   @unique
  color       String   @default("slate")
  afterStatus String
  createdAt   DateTime @default(now())
}

// Lab expenses for the monthly report. `month` is the first day of the month
// (UTC). A recurring expense counts every month from `month` up to and
// including `endMonth` (or forever when it's empty).
model Expense {
  id        String    @id @default(cuid())
  name      String
  amount    Float
  month     DateTime
  recurring Boolean   @default(false)
  endMonth  DateTime?
  createdAt DateTime  @default(now())
}

// A person from an assignable role working on a case. The fee is locked when
// they're assigned (role fee per unit x the case's units).
model CaseAssignment {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  fee       Float?
  createdAt DateTime @default(now())

  @@unique([caseId, roleId])
}
