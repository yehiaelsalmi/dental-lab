// Prisma schema for the dental lab case management system
//
// SQLite has no native enum type, so Role/CaseStatus/CaseFileType/ReviewDecision
// are plain strings constrained at the application layer — see src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  casesCreated  Case[]         @relation("CreatedBy")
  casesAssigned Case[]         @relation("AssignedDesigner")
  filesUploaded CaseFile[]
  reviews       CaseReview[]
  notifications Notification[]
  invoices      Invoice[]
}

model Doctor {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  cases    Case[]
  invoices Invoice[]
}

model Ceramist {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  cases Case[]
}

model IbarDesigner {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  cases Case[]
}

// Fixed rate card, managed by the Lab Leader. Rates are per unit and get
// locked onto the case at the moment each fee is actually incurred, so
// later rate changes never retroactively change past cases.
model Material {
  id                  String   @id @default(cuid())
  name                String   @unique
  pricePerUnit        Float
  ceramistFeePerUnit  Float
  designerFeePerUnit  Float
  ibarFeePerUnit      Float?
  // Flat amounts per case, added to / taken off the price billed to the doctor.
  extraFee            Float?
  deduction           Float?
  createdAt           DateTime @default(now())

  cases Case[]
}

model MetalType {
  id        String   @id @default(cuid())
  name      String   @unique
  cost      Float
  createdAt DateTime @default(now())

  cases Case[]
}

model Case {
  id             String    @id @default(cuid())
  patientName    String
  unitsUpper     Int?
  unitsLower     Int?
  system         String?
  shade          String?
  status         String    @default("READY_FOR_DESIGN")
  entryDate      DateTime  @default(now())
  dueDate        DateTime?
  notes          String?
  driveFolderId  String?
  driveFolderUrl String?

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  ceramistId String?
  ceramist   Ceramist? @relation(fields: [ceramistId], references: [id])

  ibarDesignerId String?
  ibarDesigner   IbarDesigner? @relation(fields: [ibarDesignerId], references: [id])

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id])

  metalTypeId String?
  metalType   MetalType? @relation(fields: [metalTypeId], references: [id])

  // Locked-in amounts, filled in as each fee is actually incurred (see the
  // comment on Material above).
  totalPrice Float?
  extraFee    Float?
  deduction   Float?
  ceramistFee Float?
  designerFee Float?
  ibarFee     Float?
  metalCost   Float?

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  assignedDesignerId String?
  assignedDesigner   User?   @relation("AssignedDesigner", fields: [assignedDesignerId], references: [id])

  files         CaseFile[]
  reviews       CaseReview[]
  notifications Notification[]
  units         CaseUnit[]
  invoiceLines  InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CaseUnit {
  id        String   @id @default(cuid())
  code      String
  createdAt DateTime @default(now())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CaseFile {
  id          String @id @default(cuid())
  caseId      String
  case        Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type        String
  fileName    String
  driveFileId String
  driveLink   String

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
}

// Runtime settings edited from the admin UI (e.g. Google Drive connection),
// as opposed to deploy-time secrets which stay in .env.
model AppSetting {
  key   String @id
  value String
}

model CaseReview {
  id       String  @id @default(cuid())
  caseId   String
  case     Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  decision String
  comment  String?

  reviewedById String
  reviewedBy   User   @relation(fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// One per doctor per calendar month. Snapshots line amounts at generation
// time, so later edits to a case never change an already-generated invoice.
model Invoice {
  id          String   @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  totalAmount Float
  createdAt   DateTime @default(now())

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  generatedById String
  generatedBy   User   @relation(fields: [generatedById], references: [id])

  lines InvoiceLine[]

  @@unique([doctorId, periodStart])
}

model InvoiceLine {
  id          String @id @default(cuid())
  patientName String
  units       Int
  amount      Float

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
}
